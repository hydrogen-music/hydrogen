set -u

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT" || exit 2

SRC_DIR="src"

# Normalize a source line: strip leading/trailing whitespace, collapse internal
# whitespace runs to single spaces.
normalize() {
	printf '%s' "$1" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' \
						   -e 's/[[:space:]]\{1,\}/ /g'
}

# Allowlist stored as newline-separated "<relpath>|||<normalized line>" keys.
# A plain string (not an associative array) keeps this compatible with the
# bash 3.2 shipped on macOS.
ALLOW=""
allow() { ALLOW="${ALLOW}$1|||$2
"; }

# --- No exceptions yet: every Qt forward declaration in the tree is
#     wrapped (the 2026-09 sweep). ---------------------------------------------

# One awk per file: comment-only lines are skipped, the
# QT_BEGIN_NAMESPACE/QT_END_NAMESPACE state is tracked across lines (a
# declaration counts as enclosed if the enclosure was already open at the
# start of its line or opens on it), and every bare Qt forward declaration
# is reported as "<file>:<lineno>:<line>". At end-of-file an unclosed
# enclosure is reported at the line of its QT_BEGIN_NAMESPACE.
scan_file() {
	awk -v file="$1" '
		/^[[:space:]]*\/\// { next }
		{
			enclosed = in_qt
			if ( $0 ~ /QT_BEGIN_NAMESPACE/ ) {
				if ( in_qt == 0 ) begin_line = FNR
				in_qt = 1
				enclosed = 1
			}
			if ( $0 ~ /QT_END_NAMESPACE/ ) in_qt = 0
			if ( enclosed ) next
			if ( $0 ~ /friend[[:space:]]+(class|struct)[[:space:]]+Q/ ) next
			if ( $0 ~ /enum[[:space:]]+class/ ) next
			if ( $0 ~ /(class|struct)[[:space:]]+Q[A-Za-z]+[[:space:]]*;/ )
				print file ":" FNR ":" $0
		}
		END {
			if ( in_qt != 0 )
				print file ":" begin_line \
					": unbalanced QT_BEGIN_NAMESPACE (no matching QT_END_NAMESPACE)"
		}
	' "$1"
}

violations=0
while IFS= read -r hit; do
	[ -z "$hit" ] && continue
	file="${hit%%:*}"
	rest="${hit#*:}"            # lineno:content
	lineno="${rest%%:*}"
	content="${rest#*:}"
	norm="$(normalize "$content")"
	if printf '%s' "$ALLOW" | grep -Fxq -- "$file|||$norm"; then
		continue
	fi
	if [ "$violations" -eq 0 ]; then
		echo "ERROR: Qt forward declaration(s) without QT_BEGIN_NAMESPACE/"
		echo "       QT_END_NAMESPACE enclosure (or unbalanced enclosure)."
		echo "       The regular build compiles these fine; only the static"
		echo "       QT_NAMESPACE build (Justfile: plugin) breaks. Wrap them"
		echo "       in QT_BEGIN_NAMESPACE/QT_END_NAMESPACE, or add a"
		echo "       documented exception to tools/check_qt_namespace."
		echo
	fi
	echo "  $file:$lineno: $norm"
	violations=$((violations + 1))
done < <( find "$SRC_DIR" \( -name '*.h' -o -name '*.cpp' \) 2>/dev/null \
			 | sort | while IFS= read -r f; do scan_file "$f"; done )

if [ "$violations" -gt 0 ]; then
	echo
	echo "Found $violations Qt declaration(s) without namespace enclosure."
	exit 1
fi

echo "check_qt_namespace: OK — every Qt forward declaration is enclosed in QT_BEGIN_NAMESPACE/QT_END_NAMESPACE."
exit 0
