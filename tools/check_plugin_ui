# along with this program. If not, see https://www.gnu.org/licenses

set -u

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT" || exit 2

UI_DIR="src/plugin/ui"

if [ ! -d "$UI_DIR" ]; then
	echo "ERROR: $UI_DIR does not exist — the guard has nothing to guard."
	exit 2
fi

# Qt application objects in any form (include, pointer, use). \b keeps
# QApplication from matching inside unrelated identifiers.
PATTERN_QT_APP='\bQApplication\b|\bQGuiApplication\b'

# Any include whose path references the GUI application tree: <gui/...>,
# "gui/...", <src/gui/...>, "../gui/...", etc.
PATTERN_GUI_INCLUDE='^[[:space:]]*#[[:space:]]*include[[:space:]]*[<"].*gui/'

violations=0
while IFS= read -r line; do
	[ -z "$line" ] && continue
	if [ "$violations" -eq 0 ]; then
		echo "ERROR: Qt-Widgets GUI application dependency in the plugin UI layer."
		echo "       The plugin UI is self-contained Dear ImGui (ADR 0035); the"
		echo "       host owns the GUI application. Fix the dependency — there is"
		echo "       no allowlist by design."
		echo
	fi
	echo "  $line"
	violations=$((violations + 1))
done < <( LC_ALL=C grep -rnE "($PATTERN_QT_APP)|($PATTERN_GUI_INCLUDE)" "$UI_DIR" 2>/dev/null )

if [ "$violations" -gt 0 ]; then
	echo
	echo "Found $violations Qt-Widgets GUI dependency(es) in the plugin UI layer."
	exit 1
fi

echo "check_plugin_ui: OK — no Qt-Widgets GUI dependencies in the plugin UI layer."
exit 0
