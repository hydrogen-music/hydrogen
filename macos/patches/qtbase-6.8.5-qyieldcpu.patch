Backport of the upstream fix in Qt >= 6.9: prefer __builtin_arm_yield.
clang >= 21 refuses to call __yield() without including <arm_acle.h>
("implicitly declaring library function '__yield'"), which breaks the
arm64 slice of Qt 6.8.5.

--- a/src/corelib/thread/qyieldcpu.h
+++ b/src/corelib/thread/qyieldcpu.h
@@ -32,7 +32,9 @@
     noexcept
 #endif
 {
-#if __has_builtin(__yield)
+#if __has_builtin(__builtin_arm_yield)
+    __builtin_arm_yield();
+#elif __has_builtin(__yield)
     __yield();              // Generic
 #elif defined(_YIELD_PROCESSOR) && defined(Q_CC_MSVC)
     _YIELD_PROCESSOR();     // Generic; MSVC's <atomic>
